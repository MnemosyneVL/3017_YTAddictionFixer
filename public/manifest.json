{
  "manifest_version": 3,
  "name": "Addiction Recovery for YouTube™ – Time Limit, Tracker & Blocker",
  "version": "1.0.0",
  "description": "YouTube detox for focus and productivity: a daily time budget, time tracker, statistics and a distraction blocker. Fully on-device.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*",
        "*://consent.youtube.com/*",
        "*://accounts.youtube.com/*",
        "*://studio.youtube.com/*",
        "*://support.youtube.com/*",
        "*://admin.youtube.com/*",
        "*://developers.youtube.com/*",
        "*://families.youtube.com/*",
        "*://tv.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*",
        "*://consent.youtube.com/*",
        "*://accounts.youtube.com/*",
        "*://studio.youtube.com/*",
        "*://support.youtube.com/*",
        "*://admin.youtube.com/*",
        "*://developers.youtube.com/*",
        "*://families.youtube.com/*",
        "*://tv.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Addiction Recovery for YouTube™",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ]
    }
  ]
}
